{
  "manifest_version": 3,
  "name": "LifetimeSoft Agent Host",
  "version": "0.0.1",
  "description": "Host application for running multiple AI agents built with @lifetimesoft/agent-sdk",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "offscreen",
    "activeTab"
  ],
  "host_permissions": [
    "https://app.lifetimesoft.com/*",
    "https://registry.lifetimesoft.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "sandbox": {
    "pages": ["sandbox/index.html"]
  },
  "web_accessible_resources": [
    {
      "resources": ["sandbox/index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "LifetimeSoft Agent Host",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
